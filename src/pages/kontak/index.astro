---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { business, businessHoursText } from '../../config/business';
import { whatsappUrl } from '../../lib/whatsapp';
---
<BaseLayout title="Kontak Cutting Laser Lampung" description="Hubungi Cutting Laser Lampung untuk konsultasi laser cutting, CNC router, material, dan fabrikasi custom di Lampung." pathname="/kontak/">
  <Breadcrumbs items={[{ label: 'Kontak' }]} />
  <section class="page-hero"><div class="shell"><div class="eyebrow">Kontak / konsultasi</div><h1>Ceritakan idenya.<br /><em>Kita bahas detailnya.</em></h1><p>Bawa referensi yang Anda sukai, ukuran bidang, dan gambaran ruangnya. Kita bahas pola, pilihan material, serta lingkup pengerjaan yang sesuai dengan rencana Anda.</p><div class="hero-actions"><a class="button button-accent" href={whatsappUrl('general')} target="_blank" rel="noopener noreferrer">Diskusikan proyek via WhatsApp ↗</a><a class="button" href={business.mapsUrl} target="_blank" rel="noopener noreferrer">Lihat lokasi workshop ↗</a></div></div></section>
  <section class="section"><div class="shell contact-grid"><div><h2>Bekal percakapan pertama</h2><ul class="check-list"><li>File desain, sketsa, atau foto referensi</li><li>Ukuran bidang, jumlah kebutuhan, dan fungsi akhir</li><li>Material, finishing, atau kebutuhan pemasangan</li><li>Foto lokasi atau konteks penggunaan yang ingin dibahas</li></ul><div class="contact-box"><h3>Media sosial</h3><p><a href={business.socialUrls.instagram} target="_blank" rel="noopener noreferrer">Instagram</a> · <a href={business.socialUrls.facebook} target="_blank" rel="noopener noreferrer">Facebook</a> · <a href={business.socialUrls.tiktok} target="_blank" rel="noopener noreferrer">TikTok</a></p></div></div><div><div class="contact-box"><h3>WhatsApp</h3><p><a href={whatsappUrl('general')} target="_blank" rel="noopener noreferrer">{business.phoneDisplay}</a></p><p><a href={`tel:+${business.phone}`}>Telepon: {business.phoneDisplay}</a></p></div><div class="contact-box"><h3>Email</h3><p><a href={`mailto:${business.email}`}>{business.email}</a></p></div><div class="contact-box"><h3>Workshop</h3><p>{business.address}</p><p><a href={business.mapsUrl} target="_blank" rel="noopener noreferrer">Buka Google Maps</a></p></div><div class="contact-box"><h3>Jam operasional</h3><p>{businessHoursText}</p></div></div></div></section>
</BaseLayout>
