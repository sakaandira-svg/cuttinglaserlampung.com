---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
import ServiceCard from '../components/ServiceCard.astro';
import { whatsappUrl } from '../lib/whatsapp';
const featured = services.slice(0, 6);
const schema = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': 'https://cuttinglaserlampung.com/#website', name: 'Cutting Laser Lampung', url: 'https://cuttinglaserlampung.com/' };
---
<BaseLayout title="Cutting Laser Lampung | Laser Cutting, CNC & Fabrikasi" description="Laser cutting, CNC router, pengolahan material, dan fabrikasi arsitektural di Lampung. Kirim desain, foto, atau ukuran untuk konsultasi.">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="hero"><div class="shell hero-grid"><div><div class="eyebrow">Laser cutting / CNC / fabrication — Lampung</div><h1>Ide yang presisi, <em>dibuat nyata.</em></h1><p class="hero-copy">Layanan laser cutting, CNC router, dan fabrikasi custom untuk kebutuhan arsitektur, interior, signage, dan elemen bangunan.</p><div class="hero-actions"><a class="button button-accent" href={whatsappUrl()} target="_blank" rel="noopener noreferrer" data-event="whatsapp-hero">Konsultasi via WhatsApp ↗</a><a class="button" href="/portfolio/">Lihat portfolio <span aria-hidden="true">↗</span></a></div></div><aside class="hero-aside"><div class="eyebrow">01 — Mulai dari kebutuhanmu</div><strong>Desain belum final? Tidak masalah.</strong><p>Kirim sketsa, foto referensi, ukuran, atau file yang sudah ada. Kita mulai dari detail yang paling jelas.</p></aside></div></section>
  <section class="section"><div class="shell"><div class="section-heading"><h2>Proses yang rapi untuk hasil yang terasa tepat.</h2><p>Dari pemilihan proses sampai detail pola, setiap pekerjaan dimulai dari konteks penggunaan yang nyata.</p></div><div class="service-grid">{featured.map((service) => <ServiceCard service={service} />)}</div><div style="margin-top:24px"><a class="text-link" href="/layanan/">Lihat seluruh layanan dan material ↗</a></div></div></section>
  <section class="section section-tint"><div class="shell split"><div><div class="eyebrow">Cara kerja</div><h2>Terukur sejak percakapan pertama.</h2></div><div class="steps"><div class="step"><span>01</span><div><h3>Kirim kebutuhan</h3><p>Bagikan desain, foto lokasi, ukuran, material yang diinginkan, dan fungsi akhirnya.</p></div></div><div class="step"><span>02</span><div><h3>Bahas detail produksi</h3><p>Kita menyamakan bentuk, skala, finishing, dan hal teknis yang relevan sebelum pengerjaan.</p></div></div><div class="step"><span>03</span><div><h3>Wujudkan dengan presisi</h3><p>File yang siap diproses diteruskan ke tahap produksi sesuai kesepakatan pekerjaan.</p></div></div></div></div></section>
  <section class="cta-band"><div class="shell cta-inner"><h2>Punya pola, bidang, atau ide yang ingin dibuat?</h2><a class="button button-dark" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">Mulai konsultasi ↗</a></div></section>
</BaseLayout>
