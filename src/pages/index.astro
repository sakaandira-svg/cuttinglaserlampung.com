---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
import ServiceCard from '../components/ServiceCard.astro';
import { whatsappUrl } from '../lib/whatsapp';
const featured = services.slice(0, 6);
---
<BaseLayout title="Cutting Laser Lampung | Laser Cutting, CNC & Fabrication di Lampung" description="Cutting Laser Lampung menyediakan jasa laser cutting, CNC router, dan fabrikasi custom di Bandar Lampung, Lampung. Konsultasi cepat via WhatsApp dan kunjungan ke workshop.">
  <section class="hero"><div class="shell hero-grid"><div><div class="eyebrow">Laser cutting / CNC / fabrikasi — Bandar Lampung, Lampung</div><h1>Laser cutting dan CNC router untuk kebutuhan presisi di Lampung.</h1><p class="hero-copy">Cutting Laser Lampung membantu proyek rumah, bangunan, signage, pagar, partisi, dan produk custom dengan proses yang jelas, cepat, dan sesuai kebutuhan. Kami siap menerima desain, ukuran, foto referensi, atau kebutuhan material yang ingin dipotong.</p><div class="hero-actions"><a class="button button-accent" href={whatsappUrl('general')} target="_blank" rel="noopener noreferrer" data-event="whatsapp-hero">Konsultasi via WhatsApp ↗</a><a class="button" href="/portfolio/">Lihat portfolio <span aria-hidden="true">↗</span></a></div></div><aside class="hero-aside"><div class="eyebrow">01 — Mulai dari kebutuhanmu</div><strong>Desain belum final? Tidak masalah.</strong><p>Kirim sketsa, foto referensi, ukuran, atau file yang sudah ada. Dari situ kita bahas proses, material, dan hasil yang paling masuk akal.</p></aside></div></section>
  <section class="section"><div class="shell"><div class="section-heading"><h2>Solusi cutting laser Lampung untuk material dan aplikasi custom.</h2><p>Dari plat besi, stainless, acrylic, ACP, hingga CNC router dan pagar laser cutting, setiap kebutuhan dibahas sesuai fungsi, material, dan ruang penerapannya.</p></div><div class="service-grid">{featured.map((service) => <ServiceCard service={service} />)}</div><div style="margin-top:24px"><a class="text-link" href="/layanan/">Lihat seluruh layanan dan material ↗</a></div></div></section>
  <section class="section section-tint"><div class="shell split"><div><div class="eyebrow">Cara kerja</div><h2>Terukur sejak percakapan pertama.</h2></div><div class="steps"><div class="step"><span>01</span><div><h3>Kirim kebutuhan</h3><p>Bagikan desain, foto lokasi, ukuran, material yang diinginkan, dan fungsi akhirnya.</p></div></div><div class="step"><span>02</span><div><h3>Bahas detail produksi</h3><p>Kita menyamakan bentuk, skala, finishing, dan hal teknis yang relevan sebelum pengerjaan.</p></div></div><div class="step"><span>03</span><div><h3>Wujudkan dengan presisi</h3><p>File yang siap diproses diteruskan ke tahap produksi, dan hasil akhir dibahas sesuai kebutuhan proyek.</p></div></div></div></div></section>
  <section class="cta-band"><div class="shell cta-inner"><h2>Punya pola, bidang, atau ide yang ingin dibuat?</h2><a class="button button-dark" href={whatsappUrl('general')} target="_blank" rel="noopener noreferrer">Mulai konsultasi ↗</a></div></section>
</BaseLayout>
