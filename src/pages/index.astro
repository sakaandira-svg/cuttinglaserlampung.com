---
import BaseLayout from '../layouts/BaseLayout.astro';
import CutPathHero from '../components/CutPathHero.astro';
import ProjectMosaic from '../components/ProjectMosaic.astro';
import ApplicationIndex from '../components/ApplicationIndex.astro';
import FabricationFlow from '../components/FabricationFlow.astro';
import MaterialStrip from '../components/MaterialStrip.astro';
import ProjectCTA from '../components/ProjectCTA.astro';
import { portfolio } from '../data/portfolio';
---
<BaseLayout title="Cutting Laser Lampung | Laser Cutting, CNC & Fabrication di Lampung" description="Jasa laser cutting Lampung, CNC router, dan fabrikasi custom untuk interior, fasad, pagar, signage, serta ornamen. Diskusikan desain dan material bersama Cutting Laser Lampung.">
  <CutPathHero />
  <section class="featured-work section" id="pilihan-visual" aria-labelledby="showcase-title"><div class="shell">
    <div class="compact-heading"><p class="eyebrow">Pilihan studi / 01—03</p><h2 id="showcase-title">Potongan yang<br /><em>mengubah bidang.</em></h2><a class="text-link" href="/portfolio/">Buka seluruh galeri ↗</a></div>
    <p class="gallery-disclosure">Ilustrasi konsep. Bukan foto proyek. <a href="/kontak/">Minta dokumentasi pekerjaan ↗</a></p>
    <ProjectMosaic items={portfolio.slice(0,3)} id="featured" />
  </div></section>
  <ApplicationIndex />
  <FabricationFlow />
  <section class="detail-studies section" aria-labelledby="detail-title"><div class="shell"><div class="compact-heading"><p class="eyebrow">Eksplorasi / 04—06</p><h2 id="detail-title">Lihat lebih <em>dekat.</em></h2><a class="text-link" href="/portfolio/">Indeks visual ↗</a></div><ProjectMosaic items={portfolio.slice(3)} id="detail" compact /></div></section>
  <MaterialStrip />
  <ProjectCTA />
</BaseLayout>
