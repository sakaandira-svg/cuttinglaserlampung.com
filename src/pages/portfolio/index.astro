---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProjectPlate from '../../components/ProjectPlate.astro';
import ProjectCTA from '../../components/ProjectCTA.astro';
import { portfolio } from '../../data/portfolio';
import { whatsappUrl } from '../../lib/whatsapp';
---
<BaseLayout title="Portfolio & Eksplorasi Desain | Cutting Laser Lampung" description="Jelajahi aplikasi laser cutting untuk fasad, partisi, ornamen, dan lettering. Galeri studi visual dan konsultasi dokumentasi pekerjaan Cutting Laser Lampung." pathname="/portfolio/">
  <Breadcrumbs items={[{ label: 'Portfolio' }]} />
  <section class="gallery-intro"><div class="shell"><p class="eyebrow">Cutting Laser Lampung / Indeks visual</p><div class="gallery-title-row"><h1>BIDANG<br /><span class="cut-word">EKSPLORASI.</span></h1><p>Fasad. Partisi. Ornamen.<br /> Dari pola menuju kemungkinan.</p><span class="gallery-plus" aria-hidden="true">+</span></div><div class="gallery-intro-bottom"><p class="gallery-disclosure">Ilustrasi konsep. Bukan foto proyek.</p><a class="text-link" href={whatsappUrl('portfolio')} target="_blank" rel="noopener noreferrer">Minta dokumentasi pekerjaan ↗</a></div></div></section>
  <nav class="shell gallery-index" aria-label="Kategori portfolio">{portfolio.map(item => <a href={`#${item.id}`}><span>{item.code.split(' / ')[0]}</span>{item.tags[0]}<span aria-hidden="true">↘</span></a>)}</nav>
  <section class="shell gallery-floor" aria-label="Galeri studi aplikasi">{portfolio.map((item, index) => <ProjectPlate item={item} instance={`gallery-${index}`} detail priority={index === 0} />)}</section>
  <div class="shell gallery-end"><span class="eyebrow">Pola adalah titik mulai.</span><p>Ukuran, bahan, dan finishing mengikuti proyek Anda.</p><a class="text-link" href="/layanan/">Jelajahi layanan ↗</a></div>
  <ProjectCTA />
</BaseLayout>
