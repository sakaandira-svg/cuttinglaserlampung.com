---
import { whatsappUrl } from '../lib/whatsapp';
import { business, businessHoursText } from '../config/business';
---
<section class="project-cta" aria-labelledby="cta-title"><div class="shell cta-drawing"><div class="cta-heading"><p class="eyebrow">LPG / Workshop & konsultasi</p><h2 id="cta-title">PUNYA<br /><span>POLA?</span></h2><p>Kirim sketsa. Ceritakan ruangnya.<br />Kita bahas cara mewujudkannya.</p><a class="button button-dark" href={whatsappUrl()} target="_blank" rel="noopener noreferrer" data-event="whatsapp-closing">Mulai percakapan <span aria-hidden="true">↗</span></a></div><div class="cta-sheet"><svg viewBox="0 0 280 250" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M20 35H235L260 60V230H20ZM20 35L45 10H260V230M35 20V245M5 50H275" /><path d="M70 184V105Q70 65 108 65Q146 65 146 105V184H128V105Q128 83 108 83Q88 83 88 105V184ZM170 65H190V166H229V184H170Z" /><path d="M60 205H235M60 197V213M235 197V213" /></svg><address><strong>Bandar Lampung</strong><span>{business.address}</span></address><a class="text-link" href={business.mapsUrl} target="_blank" rel="noopener noreferrer">Buka lokasi workshop ↗</a><p class="cta-hours">{businessHoursText}</p></div><span class="cta-registration" aria-hidden="true">+</span></div></section>
