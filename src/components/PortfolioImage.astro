---
import { Image } from 'astro:assets';
import type { PortfolioItem } from '../data/portfolio';
interface Props { item: PortfolioItem; priority?: boolean; sizes?: string; }
const { item, priority = false, sizes = '(max-width: 760px) 100vw, 65vw' } = Astro.props;
---
<Image src={item.image} alt={item.alt} widths={[480, 800, 1200, 1536]} sizes={sizes} format="webp" quality={80} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async" style={`object-position: ${item.focus}`} />
