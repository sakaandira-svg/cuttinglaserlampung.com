---
import { whatsappUrl } from '../lib/whatsapp';
const links = [
  { href: '/', label: 'Beranda' },
  { href: '/portfolio/', label: 'Portfolio' },
  { href: '/layanan/', label: 'Layanan' },
  { href: '/panduan-file-desain-laser-cutting/', label: 'Panduan file' },
  { href: '/kontak/', label: 'Kontak' },
];
const currentPath = Astro.url.pathname;
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">CL</span><span class="brand-name">Cutting Laser <b>Lampung</b></span></a>
    <nav class="desktop-nav" aria-label="Navigasi utama"><ul class="nav-links">{links.map((link) => <li><a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a></li>)}</ul></nav>
    <a class="button button-small header-cta" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">Diskusi proyek <span aria-hidden="true">↗</span></a>
    <details class="mobile-menu"><summary>Menu</summary><nav aria-label="Navigasi seluler">{links.map((link) => <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>)}<a href={whatsappUrl()} target="_blank" rel="noopener noreferrer">Diskusi via WhatsApp ↗</a></nav></details>
  </div>
</header>
