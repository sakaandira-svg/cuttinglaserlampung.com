---
import ProjectPlate from './ProjectPlate.astro';
import type { PortfolioItem } from '../data/portfolio';
interface Props { items: PortfolioItem[]; id: string; compact?: boolean; }
const { items, id, compact = false } = Astro.props;
---
<div class:list={['project-mosaic', { 'mosaic-compact': compact }]}>{items.map((item, index) => <ProjectPlate item={item} instance={`${id}-${index}`} />)}</div>
