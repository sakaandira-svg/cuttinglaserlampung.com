---
import { business, businessHoursText } from '../config/business';
import { whatsappUrl } from '../lib/whatsapp';
---
<footer class="site-footer">
  <div class="shell footer-grid">
    <div><a class="brand footer-brand" href="/"><span class="brand-mark" aria-hidden="true">CL</span><span class="brand-name">Cutting Laser <b>Lampung</b></span></a><p class="muted">Laser cutting, CNC router, dan fabrikasi custom. Mengolah pola dan material menjadi elemen interior, eksterior, serta identitas visual.</p><p class="muted">{business.address}</p><p class="muted">{businessHoursText}</p></div>
    <div class="footer-links"><p class="footer-label">Eksplorasi</p><a href="/portfolio/">Portfolio & ide aplikasi</a><a href="/layanan/">Layanan & material</a><a href="/area-layanan/">Area layanan</a><a href="/panduan-file-desain-laser-cutting/">Panduan file desain</a><a href="/kontak/">Kontak workshop</a></div>
    <div class="footer-links"><p class="footer-label">Mulai percakapan</p><a href={whatsappUrl()} target="_blank" rel="noopener noreferrer">WhatsApp {business.phoneDisplay} ↗</a><a href={`tel:+${business.phone}`}>Telepon workshop</a><a href={business.mapsUrl} target="_blank" rel="noopener noreferrer">Lokasi di Google Maps ↗</a><a href={business.socialUrls.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href={business.socialUrls.facebook} target="_blank" rel="noopener noreferrer">Facebook ↗</a><a href={business.socialUrls.tiktok} target="_blank" rel="noopener noreferrer">TikTok ↗</a></div>
  </div>
  <div class="shell footer-bottom"><span>© {new Date().getFullYear()} {business.brandName}</span><span>Presisi dalam bentuk. Karakter dalam ruang.</span></div>
</footer>
