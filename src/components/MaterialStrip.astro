---
const materials = [
  { label: 'Plat besi', color: '#355548', highlight: '#8d9e90', href: '/laser-cutting-plat-besi-lampung/' },
  { label: 'Stainless', color: '#a0aaa1', highlight: '#f8f9ed', href: '/laser-cutting-stainless-lampung/' },
  { label: 'Acrylic', color: '#c4dacf', highlight: '#f3fcf6', href: '/laser-cutting-acrylic-lampung/' },
  { label: 'ACP', color: '#c6c9bc', highlight: '#ebeee4', href: '/laser-cutting-acp-lampung/' },
  { label: 'MDF', color: '#a8774b', highlight: '#d2ae79', href: '/laser-cutting-mdf-lampung/' },
];
---
<section class="material-section" aria-labelledby="material-title"><div class="shell"><div class="compact-heading"><p class="eyebrow">Material / Detail</p><h2 id="material-title">Bahan punya <em>bahasa.</em></h2><span class="material-note">Ilustrasi material</span></div><div class="material-strip">{materials.map((material, index) => <a href={material.href} class="material-sample"><span class="eyebrow">MAT / 0{index + 1}</span><svg viewBox="0 0 210 235" role="img" aria-label={`Ilustrasi lapisan ${material.label}`}><defs><linearGradient id={`sample-${index}`} x1="0" x2="1" y1="0" y2="1"><stop stop-color={material.highlight} /><stop offset=".55" stop-color={material.color} /><stop offset="1" stop-color={material.highlight} /></linearGradient></defs><path d="M20 98L116 39L190 84L94 145Z" fill="#0a292420" transform="translate(0 63)" />{[2,1,0].map(layer => <path d="M20 98L116 39L190 84L150 108L129 95L91 119L111 132L94 145Z" transform={`translate(0 ${layer * 23})`} fill={`url(#sample-${index})`} stroke={material.color} stroke-width="1" />)}<path d="M20 204H190M20 197V211M190 197V211" fill="none" stroke="#71867b" stroke-width="1" /></svg><span class="material-name">{material.label}<span aria-hidden="true">↗</span></span></a>)}</div></div></section>
