---
interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
---
<nav class="breadcrumbs shell" aria-label="Breadcrumb"><a href="/">Beranda</a>{items.map((item) => <><span aria-hidden="true">/</span>{item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</>)}</nav>
