---
import '../styles/global.css';
import { business, siteUrl } from '../config/business';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppBar from '../components/WhatsAppBar.astro';

interface Props { title: string; description: string; pathname?: string; noindex?: boolean; ogType?: 'website'|'article'; ogImage?: string; extraSchema?: Record<string, unknown>[]; }
const { title, description, pathname = '/', noindex = false, ogType = 'website', ogImage = `${siteUrl}/media/social.png`, extraSchema = [] } = Astro.props;
const canonical = new URL(pathname, siteUrl).toString();
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: business.brandName,
      url: siteUrl,
      description,
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: business.brandName,
      url: siteUrl,
      email: business.email,
      telephone: `+${business.phone}`,
      sameAs: Object.values(business.socialUrls),
      areaServed: 'Lampung',
      hasMap: business.mapsUrl,
      address: {
        '@type': 'PostalAddress',
        streetAddress: business.addressParts.streetAddress,
        addressLocality: business.addressParts.addressLocality,
        addressRegion: business.addressParts.addressRegion,
        postalCode: business.addressParts.postalCode,
        addressCountry: business.addressParts.addressCountry,
      },
    },
    {
      '@type': 'LocalBusiness',
      '@id': `${siteUrl}/#localbusiness`,
      name: business.brandName,
      url: siteUrl,
      telephone: `+${business.phone}`,
      email: business.email,
      sameAs: Object.values(business.socialUrls),
      areaServed: 'Lampung',
      hasMap: business.mapsUrl,
      address: {
        '@type': 'PostalAddress',
        streetAddress: business.addressParts.streetAddress,
        addressLocality: business.addressParts.addressLocality,
        addressRegion: business.addressParts.addressRegion,
        postalCode: business.addressParts.postalCode,
        addressCountry: business.addressParts.addressCountry,
      },
      openingHoursSpecification: business.openingHours
        .filter((day) => !day.closed)
        .map((day) => ({
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: day.day,
          opens: day.opens,
          closes: day.closes,
        })),
      parentOrganization: { '@id': `${siteUrl}/#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': `${siteUrl}/#website` },
      about: { '@id': `${siteUrl}/#localbusiness` },
    },
    ...extraSchema,
  ],
};
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#122c25" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={business.brandName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — ilustrasi editorial Cutting Laser Lampung`} />
    <meta name="twitter:card" content="summary_large_image" />
    {business.analytics.searchConsoleVerification && <meta name="google-site-verification" content={business.analytics.searchConsoleVerification} />}
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Lewati ke konten utama</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    <WhatsAppBar />
  </body>
</html>
